# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram user ID (get from @userinfobot)
ADMIN_USER_ID=123456789

# TEXT.ru API for rewriting (get from textru.com)
TEXT_RU_API_KEY=your_textru_api_key

# Kandinsky API for image generation (get from fusionbrain.ai)
KANDINSKY_API_KEY=your_kandinsky_api_key
KANDINSKY_SECRET_KEY=your_kandinsky_secret_key

# Telethon configuration for parsing Telegram channels
TELETHON_API_ID=your_telegram_api_id
TELETHON_API_HASH=your_telegram_api_hash

# Database path
DATABASE_PATH=news_bot.db

# Output directory for processed news
OUTPUT_DIR=output

# Maximum news items to collect per run
MAX_NEWS_PER_RUN=20

# Request timeout in seconds
REQUEST_TIMEOUT=30

# Number of retry attempts on network errors
RETRY_ATTEMPTS=3
